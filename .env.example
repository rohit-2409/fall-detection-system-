# ==============================================================================
# STAGE 6L HARDWARE & SERVICE CONFIGURATION TEMPLATE (.env.example)
# Standalone Fall Detection System
#
# Instructions:
# Copy this file to .env and fill in environment-specific parameters.
# NEVER commit .env with real credentials into version control.
# ==============================================================================

# MQTT Broker Settings
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_FALL_TOPIC=fall_detection/stage6/fall
MQTT_GPS_TOPIC=fall_detection/stage6/gps

# Serial Hardware Ingestion Settings
SERIAL_PORT=COM22
SERIAL_BAUDRATE=115200

# Backend Service
BACKEND_URL=http://127.0.0.1:5000

# ESP32 Wi-Fi Settings (For firmware upload configuration)
WIFI_SSID=
WIFI_PASSWORD=

# WhatsApp Twilio Notification Credentials (Optional for real dispatches)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_RECIPIENT=
